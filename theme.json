{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{ "slug": "navy", "name": "Navy (Space Indigo)", "color": "#262F56" },
				{ "slug": "gold", "name": "Gold (Soft Fawn)", "color": "#E7BD81" },
				{ "slug": "red", "name": "Red (Classic Crimson)", "color": "#D7263D" },
				{ "slug": "blue", "name": "Blue (Dusty Denim)", "color": "#6290C8" },
				{ "slug": "blue-light", "name": "Light blue (Wisteria Blue), decoration only", "color": "#829CBC" },
				{ "slug": "cream", "name": "Cream (Floral White)", "color": "#FFF9F0" },
				{ "slug": "ink", "name": "Ink", "color": "#1C1C1C" },
				{ "slug": "text", "name": "Body text", "color": "#4D4D4D" },
				{ "slug": "white", "name": "White", "color": "#FFFFFF" },
				{ "slug": "grey-100", "name": "Grey 100 (Light Background)", "color": "#F5F5F5" },
				{ "slug": "grey-200", "name": "Grey 200 (Tertiary)", "color": "#F0F0F0" },
				{ "slug": "grey-300", "name": "Grey 300 (Secondary)", "color": "#E6E6E6" },
				{ "slug": "grey-500", "name": "Grey 500 (Light Gray), decoration only", "color": "#999999" }
			]
		},
		"custom": {
			"grid": {
				"columnsMobile": "6",
				"columnsDesktop": "12",
				"margin": "clamp(1rem, -0.857rem + 9.286vw, 7.5rem)",
				"gutter": "clamp(1rem, 0.857rem + 0.714vw, 1.5rem)",
				"contentMax": "1200px"
			},
			"lineHeight": {
				"tight": "1.1",
				"snug": "1.3",
				"body": "1.6"
			},
			"measure": "65ch",
			"shadow": {
				"paper": "4px 4px 0 #E7BD81",
				"paperRaised": "6px 6px 0 #E7BD81"
			},
			"radius": {
				"field": "4px"
			}
		},
		"spacing": {
			"customSpacingSize": false,
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "4", "name": "4px", "size": "0.25rem" },
				{ "slug": "8", "name": "8px", "size": "0.5rem" },
				{ "slug": "12", "name": "12px", "size": "0.75rem" },
				{ "slug": "16", "name": "16px", "size": "1rem" },
				{ "slug": "24", "name": "24px", "size": "1.5rem" },
				{ "slug": "32", "name": "32px", "size": "2rem" },
				{ "slug": "40", "name": "40px", "size": "2.5rem" },
				{ "slug": "56", "name": "56px", "size": "3.5rem" },
				{ "slug": "80", "name": "80px", "size": "5rem" },
				{ "slug": "120", "name": "120px", "size": "7.5rem" }
			],
			"units": [ "px", "rem", "em", "%", "vw", "vh" ]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"dropCap": false,
			"fontFamilies": [
				{
					"slug": "anton",
					"name": "Anton (headings, nav, buttons)",
					"fontFamily": "Anton, Impact, 'Arial Narrow Bold', sans-serif",
					"fontFace": [
						{
							"fontFamily": "Anton",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/anton-regular/Anton-Regular.woff2" ]
						}
					]
				},
				{
					"slug": "handwritten",
					"name": "Covered By Your Grace (section headings)",
					"fontFamily": "'Covered By Your Grace', 'Segoe Print', 'Comic Sans MS', cursive",
					"fontFace": [
						{
							"fontFamily": "Covered By Your Grace",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/covered-by-your-grace/CoveredByYourGrace-Regular.woff2" ]
						}
					]
				},
				{
					"slug": "body",
					"name": "Cabin (body and UI)",
					"fontFamily": "Cabin, 'Segoe UI', Roboto, Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Cabin",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/cabin/Cabin-Regular.woff2" ]
						},
						{
							"fontFamily": "Cabin",
							"fontStyle": "normal",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/cabin/Cabin-Bold.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "step-minus-2", "name": "Label (12px)", "size": "0.75rem", "fluid": false },
				{ "slug": "step-minus-1", "name": "Small (14px)", "size": "0.875rem", "fluid": false },
				{ "slug": "step-0", "name": "Body (16px)", "size": "1rem", "fluid": false },
				{ "slug": "step-1", "name": "H5 / Lead (19 to 20px)", "size": "clamp(1.2rem, 1.186rem + 0.0714vw, 1.25rem)", "fluid": false },
				{ "slug": "step-2", "name": "H4 (23 to 25px)", "size": "clamp(1.44rem, 1.405rem + 0.175vw, 1.5625rem)", "fluid": false },
				{ "slug": "step-3", "name": "H3 (28 to 31px)", "size": "clamp(1.728rem, 1.664rem + 0.3216vw, 1.9531rem)", "fluid": false },
				{ "slug": "step-4", "name": "H2 / Section heading (33 to 39px)", "size": "clamp(2.074rem, 1.969rem + 0.5254vw, 2.4414rem)", "fluid": false },
				{ "slug": "step-5", "name": "H1 (40 to 49px)", "size": "clamp(2.488rem, 2.327rem + 0.8049vw, 3.0518rem)", "fluid": false },
				{ "slug": "step-6", "name": "Display (48 to 61px)", "size": "clamp(2.986rem, 2.749rem + 1.184vw, 3.8147rem)", "fluid": false }
			]
		}
	}
}
